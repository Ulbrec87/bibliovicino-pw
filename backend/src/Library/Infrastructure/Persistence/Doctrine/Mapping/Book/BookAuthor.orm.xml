<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Library\Domain\Book\BookAuthor" table="library_book_author">
        <indexes>
            <index name="idx_library_book_author_author_book" columns="author_id,book_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_library_book_author_position" columns="book_id,position"/>
        </unique-constraints>
        <id name="book" association-key="true"/>
        <id name="author" association-key="true"/>
        <field name="position" type="smallint" column="position"/>

        <many-to-one field="book" target-entity="App\Library\Domain\Book\Book" inversed-by="authors">
            <join-column name="book_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <many-to-one field="author" target-entity="App\Library\Domain\Author\Author">
            <join-column name="author_id" referenced-column-name="id" nullable="false" on-delete="RESTRICT"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
