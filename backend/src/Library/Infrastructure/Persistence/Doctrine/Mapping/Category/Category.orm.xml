<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Library\Domain\Category\Category" table="library_category">
        <unique-constraints>
            <unique-constraint name="uniq_library_category_slug" columns="slug"/>
        </unique-constraints>
        <id name="id" type="category_id" column="id"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="slug" type="string" column="slug" length="100"/>
        <field name="active" type="boolean" column="active">
            <options>
                <option name="default">true</option>
            </options>
        </field>
    </entity>
</doctrine-mapping>
